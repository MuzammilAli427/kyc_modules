<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_amount_wizard_form" model="ir.ui.view">
        <field name="name">Report View</field>
        <field name="model">payment.amount.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Options">
                <group>
                    <group>
                        
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="check_report" string="VIEW" type="object" default_focus="1"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_payment_amount_wizard" model="ir.actions.act_window">
        <field name="name">Report View</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">payment.amount.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="payment_amount_wizard_form"/>
        <field name="target">new</field>
    </record>
    <menuitem
            id="action_payment_amount_menu"
            name="Report View"
            parent="account.account_reports_management_menu"
            action="action_payment_amount_wizard"
    />

</odoo>

<odoo>
    <record id="view_gsh_wizard_form" model="ir.ui.view">
        <field name="name">gsh.wizard.form</field>
        <field name="model">gsh.wizard</field>
        <field name="arch" type="xml">
            <form>
            	<group>
	                <group>
	                    <field name="start_date" required="1"/>
	                	<field name="currency_id" />
	                </group>
	                <group>
	                    <field name="end_date" required="1"/>
	                	<field name="report" required="1"/>
	                	
	                </group>
	            </group>
                <footer>
                    <button name="get_pdf" type="object" 
                        class="oe_highlight" string="Print PDF"/>
                    <button name="get_xlsx" type="object" 
                        class="oe_highlight ml-5" string="Print Excel" style="margin-left:10px;"/>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gsh_wizard" model="ir.actions.act_window">
        <field name="name">GSH Report</field>
        <field name="res_model">gsh.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_gsh_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem id="menu_gsh_wizard"
              name="GSH Reports"
              parent="account_reports.account_reports_audit_reports_menu"
              sequence="100"
              action="action_gsh_wizard"/>
</odoo>
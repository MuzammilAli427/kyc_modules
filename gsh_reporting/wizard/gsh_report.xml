<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_gsh" model="ir.actions.report">
        <field name="name">GSH Report</field>
        <field name="model">gsh.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gsh_reporting.report_gsh_qweb</field>
        <field name="report_file">gsh_reporting.report_gsh_qweb</field>
    </record>

    <template id="report_gsh_qweb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-if="o.report == 'balance'">
                        <h3 class="text-center">Balance Report</h3>
                    </t>
                    <t t-else="o.report == 'income'">
                        <h3 class="text-center">Incoming Report</h3>
                    </t>
                    FROM : <strong><span t-esc="o.start_date.strftime('%B')" /> - <span t-esc="o.start_date.year" /> </strong><br/>
                    TO : <strong><span t-esc="o.end_date.strftime('%B')" /> - <span t-esc="o.end_date.year" /> </strong>
                    <t t-set="printable_vals" t-value="o._get_printable_values()"/>
                    <br/><br/><br/><br/>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th class="text-start align-middle"><span>Bank</span></th>
                                <th class="text-start align-middle"><span>Currency</span></th>
                                <t t-foreach="printable_vals.get('months')" t-as="m">
                                    <th class="text-start align-middle"><span t-esc="m"/></th>
                                </t>
                            </tr>
                       </thead>
                       <tbody>
                        <t t-foreach="printable_vals.get('monthly_balance')" t-as="journal">
                            <tr>
                                <td><span t-field="journal.name" /></td>
                                <t t-if="journal.currency_id">
                                    <td><span t-field="journal.currency_id" /></td>
                                </t>
                                <t t-else="">
                                    <td><span t-esc="journal.company_id.currency_id.name" /></td>
                                </t>
                                <t t-foreach="printable_vals.get('months')" t-as="m">
                                    <td><t t-esc="printable_vals.get('monthly_balance').get(journal).get(m) or 0" /></td>
                                </t>
                            </tr>
                        </t>

                       </tbody>
                   </table>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_inv_lines" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <field name="is_customer_inv" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <field name="selected_amount" invisible="1"/>
                <notebook attrs="{'invisible': [('is_customer_inv', '=', False)]}"><!-- attrs="{'invisible': [('is_customer_inv', '=', False)]}"-->
                    <page string="Register Payment by Invoice lines" name="inv_lines">
                        <field name="inv_line_ids" ><!-- -->
                            <tree create="0" delete="0" editable="bottom">
                                <field name="select" attrs="{'readonly': [('fully_paid', '=',True)]}"/>
                                <field name="fully_paid" invisible="1"/>
                                <field name="id" invisible="1" readonly="True"/>
                                <field name="product_id" readonly="True"/>
                                <field name="name" readonly="True"/>
                                <field name="account_id" groups="account.group_account_readonly" readonly="True"/>
                                <field name="quantity" readonly="True"/>
                                <field name="product_uom_id" string="UoM" groups="uom.group_uom" optional="show" readonly="True"/>
                                <field name="price_unit" string="Price" readonly="True"/>
                                <field name="discount" string="Disc.%" optional="hide" readonly="True"/>
                                <field name="tax_ids" widget="many2many_tags" optional="show" readonly="True"/>
                                <field name="price_subtotal" string="Subtotal" groups="account.group_show_line_subtotals_tax_excluded" readonly="True"/>
                                <field name="price_total" string="Total" readonly="True"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_paid_selection" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]/field[@name='invoice_line_ids']/tree/field[@name='sequence']" position="before">
                <!--field name="fully_paid" optional="show" attrs="{'readonly': True}" invisible="context.get('default_move_type') != 'out_invoice'"/-->
                <field name="fully_paid" optional="show" attrs="{'readonly': True}" invisible="context.get('default_move_type') not in ['out_invoice','in_invoice']"/>
                
                <!-- 'invisible': [('parent.move_type', '!=', 'out_invoice')]-->
                <field name="select" optional="show" attrs="{'readonly': True}" invisible="1"/>
            </xpath>
            
            <xpath expr="//notebook/page[1]/field[@name='invoice_line_ids']" position="after">
                <field name="pay_by_line_execute" invisible="1"/>
            </xpath>
<!--            <xpath expr="//notebook/page[1]/group//field[@name='invoice_outstanding_credits_debits_widget']" position="attributes">-->
<!--                <attribute name="attrs">{'invisible': ['|','|',('state', '!=', 'posted'), ('move_type', 'in', ('out_receipt', 'in_receipt')),('pay_by_line_execute','=',True)]}</attribute>-->
<!--            </xpath>-->
        </field>
    </record>
    
    <record id="view_account_payment_form_add_paid_inv_line_ids" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[@name='group1']/field[@name='ref']" position="after">
                <field name="paid_inv_line_ids" widget="many2many_tags" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>

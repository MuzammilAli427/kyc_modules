<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="payment_by_inv_line_report_menu_id" model="ir.actions.report">
            <field name="name">Payment By Items Line Report</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">payment_by_invoice_lines_omax.payment_by_inv_line_tmpl_id</field>
            <field name="report_file">payment_by_invoice_lines_omax.payment_by_inv_line_tmpl_id</field>
            <field name="print_report_name">(object._get_inv_pay_report_base_filename())</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="binding_type">report</field>
        </record>

    	<template id="payment_by_inv_line_tmpl_id">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                    <t t-call="payment_by_invoice_lines_omax.payment_by_inv_line_report_document" t-lang="lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>

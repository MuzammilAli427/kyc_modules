<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_add_partial_paid" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="payment_by_invoice_lines_omax.view_move_form_paid_selection"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fully_paid']" position="after">
                <!--field name="partial_paid" optional="show" attrs="{'readonly': True}" invisible="context.get('default_move_type') != 'out_invoice'"/-->
                <field name="partial_paid" optional="show" attrs="{'readonly': True}" invisible="context.get('default_move_type') not in ['out_invoice','in_invoice']"/>
                <field name="paid_amount" invisible="1"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_account_payment_form_add_payment_inv_line" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[@name='group1']/field[@name='ref']" position="after">
                <field name="payment_inv_line" invisible="0"><!-- -->
                    <tree create="false" edit="false" delete="false">
                        <field name="move_line_id"/>
                        <field name="paid_amount"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>

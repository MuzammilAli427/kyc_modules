<odoo>
    <data>
        <record id="geoip_redirect_view" model="ir.ui.view">
            <field name="name">geoip.redirect.settings.form</field>
            <field name="model">geoip.redirect.settings</field>
            <field name="arch" type="xml">
                <form string="GeoIP Redirect" class="oe_form_configuration">
                    <sheet>
                        <separator string="GeoIP Redirect"/>
                        <group>
                            <label for="enable_geoip"/>
                            <b><field name="enable_geoip"/></b>
                        </group>
                        <group>
                            <label for="hide_odoo_languages"/>
                            <b><field name="hide_odoo_languages"/></b>
                        </group>
                        <group>
                            <label for="show_geo_country"/>
                            <b><field name="show_geo_country"/></b>
                        </group>
                        <separator string="Auto Redirect Setting"/>
                        <group>
                            <group>
                                <label for="enable_auto_redirect"/>
                                <b><field name="enable_auto_redirect"/></b>
                            </group>
                            <group>
                                <label for="first_visit"/>
                                <b><field name="first_visit"/></b>
                            </group>
                        </group>
                        <separator string="GeoIP Restriction Setting"/>
                        <group>
                            <label for="ignore_search_engines"/>
                            <b><field name="ignore_search_engines"/></b>
                        </group>
                        <br/>
                        <footer>
                        <button string="Apply" type="object" name="execute" class="oe_highlight"/>
                        or
                        <button special="cancel" string="Cancel" class="btn-default"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="action_geoip_redirect_conf" model="ir.actions.act_window">
          <field name="name">GeoIP Redirect</field>
          <field name="res_model">geoip.redirect.settings</field>
          <field name="view_mode">form</field>
          <field name="target">new</field>
        </record>
    </data>
</odoo>
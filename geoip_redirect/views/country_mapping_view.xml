<odoo>
    <record id="customer_mapping_tree_view" model="ir.ui.view">
        <field name="name">country.mapping.tree</field>
        <field name="model">country.mapping</field>
        <field name="field_parent" eval="False"/>
        <field name="arch" type="xml">
            <tree string="Country Mapping" editable="bottom">
                <field name="country_id"/>
                <field name="currency_id"/>
                <field name="pricelist_id" domain="[('currency_id','=',currency_id)]"/>
                <field name="lang_id"/>
                <field name="add_url"/>
                <field name="custom_url" attrs="{'readonly': [('add_url','!=', True)], 'required': [('add_url','==', True)]}"/>
            </tree>
        </field>
    </record>

    <record id="action_customer_mapping" model="ir.actions.act_window">
        <field name="name">Country Mapping</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">country.mapping</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree</field>
        <field name="view_id" eval="False"/>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            Click to add country mapping.
          </p>
        </field>
    </record>
</odoo>
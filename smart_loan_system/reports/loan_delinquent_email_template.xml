<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="email_template_interest_letter" model="mail.template">
            <field name="name">Loan: Sending</field>
            <field name="model_id" ref="smart_loan_system.model_loan_delinquent_wizard"/>
            <field name="email_from">{{ (user.email_formatted) }}</field>
            <field name="partner_to">{{ object.loan_ids[0].partner_id.id }}</field>
            <field name="description">Sent to customers with their loans in attachment</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear
        <t>
            <t t-out="object.loan_ids[0].partner_id.name or ''">Brandon Freeman</t>,
        </t>
        <br /><br />
        Here is your
        <t t-if="object.loan_ids[0].name">
            Interest Letter amounting in <span style="font-weight:bold;" t-out="format_amount(object.interest_amount, object.loan_ids[0].currency_id) or ''">$ 143,750.00</span> from <t t-out="object.loan_ids[0].partner_id.name or ''">Azure Interior</t>
        </t>
        <t t-else="">
            Interest Letter
        </t>.
        <t>
            Please use following communication for your <t t-out="object.loan_ids[0].name or ''">Loan</t>.
        </t>

        <br /><br />
        Do not hesitate to contact us if you have any questions.
    </p>
</div>
            </field>
            <field name="lang">{{ object.loan_ids[0].partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>

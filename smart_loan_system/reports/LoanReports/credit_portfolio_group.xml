<odoo>
    <record id="credit_portfolio_group_wizard" model="ir.ui.view">
        <field name="name">credit.portfolio.group</field>
        <field name="model">credit.portfolio.group</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Credit Portfolio Group">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="country_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                    </group>
                </group>
                <footer>
                    <button class="oe_highlight" name="get_report" string="Get Report" type="object"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id='credit_portfolio_group_action' model='ir.actions.act_window'>
        <field name="name">Credit Portfolio Group</field>
        <field name="res_model">credit.portfolio.group</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem name="Credit Portfolio Group" id="credit_portfolio_group_submenu_id"
              parent="loan_reports_menu"
              action="smart_loan_system.credit_portfolio_group_action"/>

    <template id="credit_portfolio_group_template">
        <t t-call="web.html_container">
<!--            <t t-foreach="docs" t-as="o">-->
<!--                <t t-call="web.external_layout">-->
                    <div class="page">
                        <style>
                            #collected_per_business_table {
                                width: 100%;
                            }

                            #collected_per_business_table, th, td{
                                border: 1px solid black;
                                border-collapse: collapse;
                                border-left: 0px;
                                border-right: 0px;
                            }

                            #collected_per_business_table td, #collected_per_business_table th {
                                padding: 8px;
                                font-weight: bold;
                            }
                            #collected_per_business_table th {
                                padding-top: 1px;
                                padding-bottom: 1px;
                                text-align: left;
                            }
                            .footer_points{
                                margin-top:10px; font-size:18px;
                            }
                        </style>
                        <p style="color:#385ef5; font-size:30px; font-weight: 600;">Credit Quality</p>
                        <table border="1" id="collected_per_business_table">
                            <tr>
                                <td>Metrics Amounts in NAf. (x1000)</td>
                                <t t-foreach="wrap" t-as="o">
<!--                                      <t t-foreach="o['months']" t-as="rec">-->
                                        <td><t t-out="o['months']"/></td>
                                            <td>Number of Loans</td>
<!--                                        </t>-->
                                </t>
                            </tr>
                            <tr>
                                <td>Satisfactory (0-29 days)</td>
                                <t t-foreach="wrap" t-as="o">
                                 <t t-foreach="o['satisfactory']" t-as="rec">
                                    <td><t t-out="rec"/></td>
                                </t>
                                </t>
                            </tr>
                            <tr>
                                <td>Special Mention (30-89 days)</td>
                                <t t-foreach="wrap" t-as="o">
                                    <t t-foreach="o['special_mention']" t-as="rec">
                                    <td><t t-out="rec"/></td>
                                </t>
                                </t>
                            </tr>
                            <tr>
                                <td>Substandard (90-119 days)</td>
                                <t t-foreach="wrap" t-as="o">
                                    <t t-foreach="o['substandard']" t-as="rec">
                                    <td><t t-out="rec"/></td>
                                </t>
                                </t>
                            </tr>
                            <tr>
                                <td>Doubtful (120-179 days)</td>
                                 <t t-foreach="wrap" t-as="o">
                                   <t t-foreach="o['doubtful']" t-as="rec">
                                    <td><t t-out="rec"/></td>
                                </t>
                                 </t>
                            </tr>
                            <tr>
                                <td>Loss (180 days >)</td>
                                 <t t-foreach="wrap" t-as="o">
                                    <t t-foreach="o['loss']" t-as="rec">
                                    <td><t t-out="rec"/></td>
                                </t>
                                 </t>
                            </tr>
                            <tr>
                                <td>Total</td>
                                 <t t-foreach="wrap" t-as="o">
                                   <t t-foreach="o['total']" t-as="rec">
                                        <td><t t-out="rec"/></td>
                                    </t>
                                 </t>
                            </tr>

                        </table>

                        <p class="footer_points">The Credit quality is determined by the oldest outstanding installment of a loan</p>
                        <p class="footer_points">The amounts reported are the loan balances excluding any open installments</p>
                        <p class="footer_points">Report Source: Loan Module for amounts, rating for open installments depending on Design Loan Module in odoo</p>
                    </div>
<!--                </t>-->
<!--            </t>-->
        </t>
    </template>

    <record id="smart_loan_system.paperformat_for_creditportfolio_group" model="report.paperformat">
            <field name="name">A4</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>


    <record id="credit_portfolio_group_report_action" model="ir.actions.report">
        <field name="name">Credit Portfolio Group</field>
        <field name="report_type">qweb-pdf</field>
        <field name="model">credit.portfolio.group</field>
         <field name="paperformat_id" ref="smart_loan_system.paperformat_for_creditportfolio_group"/>
        <field name="report_name">smart_loan_system.credit_portfolio_group_template</field>
        <field name="report_file">smart_loan_system.credit_portfolio_group_template</field>
    </record>


</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view for Fetch Restructure Loan -->
    <record id="fetch_restructure_loan_tree" model="ir.ui.view">
        <field name="name">fetch.restructure.loan.tree</field>
        <field name="model">fetch.restructure.loan</field>
        <field name="arch" type="xml">
            <tree string="Fetch Restructure Loans">
                <field name="loan_id"/>
                <field name="date"/>
                <field name="restructure_type"/>
                <field name="outstanding_principal_amount"/>
                <field name="amount"/>
                <field name="restructure_fee"/>
                <field name="currency_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="fetch_restructure_loan_form" model="ir.ui.view">
        <field name="name">Fetch Restructure Loan Form</field>
        <field name="model">fetch.restructure.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="submit_for_approval" type="object" class="btn btn-primary" groups="smart_loan_system.group_loan_cao"
                            string="Submit For Approval" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="process_fetching_restructuring_loan" type="object" class="btn btn-primary"
                            string="Process"
                            attrs="{'invisible': [('state', '!=', 'submit_approval')]}"
                            groups="smart_loan_system.group_loan_cam"/>
                    <!--                    <button name="cancel_restructure_loan" string="Cancel" type="object"/>-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="edit_allow" invisible="1"/>
                            <field name="loan_id" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                            <field name="parent_loan_id"  readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="restructure_type" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                            <field name="outstanding_principal_amount" readonly="1"/>
                            <field name="write_off_amount"
                                   attrs="{'invisible':[('restructure_type','!=','with_writeoff')]}" readonly="1"/>
                            <field name="balance_amount" readonly="1"/>
                            <field name="outstanding_without_writoff" readonly="1"
                                   attrs="{'invisible':[('restructure_type','!=','with_writeoff')]}"/>
                            <field name="amount" readonly="1"/>
                            <field name="pay_by_customer" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                            <field name="is_restructuring_fee" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                            <field name="restructure_fee" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                            <field name="tax_amount" readonly="1"/>
                            <field name="currency_id" invisible="0" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="remaining_principal_amount" readonly="1"/>
                            <field name="remaining_interest_amount" readonly="1"/>
                            <field name="remaining_life_insurance_amount" readonly="1"/>
                            <field name="remaining_fire_insurance_amount" readonly="1"/>
                            <field name="remaining_penalties_amount" readonly="1"/>
                            <field name="remaining_ground_lease" string="Remaining Long Lease" readonly="1"/>
                            <field name="new_loan_amount" readonly="1"/>
                            <field name="difference_amount" readonly="1"/>
                            <field name="selection_wizard_id" readonly="0"/>
                        </group>
                    </group>
                    <group>
                        <field name="reject_reason"
                               attrs="{'invisible': [('state', '!=', 'rejected')], 'readonly':[('edit_allow', '=', False)]}"/>
                    </group>
                    <!--                    <group>-->
                    <notebook>
                        <page string="Write-Off"
                              attrs="{'invisible':[('restructure_type','!=','with_writeoff')], 'readonly':[('edit_allow', '=', False)]}">
                            <field name="writeoff_line_ids" context="{'default_total_write_off': write_off_amount}">
                                <tree editable="bottom">
                                    <field name="loan_id"/>
                                    <field name="company_currency_id" invisible="1"/>
                                    <field name="currency_id"/>
                                    <field name="write_off_amount" sum="Total Write-Off"/>
                                    <field name="company_currency_amount" string="Write-Off in Company Currency"
                                           sum="Total Company Write-Off"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>


    <record id="fetch_restructure_loan_action" model="ir.actions.act_window">
        <field name="name">Fetch Restructure Loan</field>
        <field name="res_model">fetch.restructure.loan</field>
        <field name="view_mode">tree,form</field>
        <!--        <field name="target">new</field>-->
    </record>

    <menuitem id="fetch_restructure_loan_menu"
              name="Fetch Restructure Loan"
              parent="account_config"
              sequence="8"
              action="fetch_restructure_loan_action"
    />

</odoo>

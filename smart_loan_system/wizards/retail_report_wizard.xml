  <template id="retail_report_template_1">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            #retail_performance_table {
                              width: 100%;
                            }

                            #retail_performance_table td, #retail_performance_table th {
                              padding: 8px;
                              font-weight: bold;
                            }
                            #retail_performance_table th {
                              padding-top: 2px;
                              padding-bottom: 2px;
                              text-align: left;
                            }
                            .footer_points{
                                margin-top:10px; font-size:18px;
                            }
                        </style>
                        <p style="color:#385ef5; font-size:30px; font-weight: 100;">Retail Performance</p>
                        <p style="margin-top:25px; font-weight: bold;">November - April 2023</p>
                        <table id="retail_performance_table">
                          <tr>
                            <th>Highlights Period <t t-out="o.date_from.strftime('%B')"/> 2022 - <t t-out="o.date_to.strftime('%B')"/> 2023</th>
                          </tr>
                          <tr>
                            <td>Total Collected Nov-April (Cur and Bon)</td>
                            <td>NAf.</td>
                            <td>0.00</td>
                          </tr>
                          <tr>
                            <td>Total settlement/Pay-offs Nov-April (Cur&amp;Bon)</td>
                            <td>NAf.</td>
                            <td>0.00</td>
                          </tr>
                          <tr>
                            <td>Total Collected/Pay-offs Nov-April (Cur&amp;Bon)</td>
                            <td>NAf.</td>
                            <td>0.00</td>
                          </tr>
                          <tr>
                            <td>Total Restructured &amp; Refinanced Nov-April (Cur&amp;Bon)</td>
                            <td>NAf.</td>
                            <td>0.00</td>
                          </tr>
                          <tr>
                            <td>Total Collected/settlements/Pay-offs/Restructured Nov-April</td>
                            <td>NAf.</td>
                            <td>0.00</td>
                          </tr>
                        </table>

                        <p class="footer_points">Amounts are performance based and rounded to nearest 1,000</p>
                        <p class="footer_points">Report is compiled manually by Soraidia</p>
                        <p class="footer_points">collected amount is the actual total amount collected incl. interest, penalties etc</p>
                        <p class="footer_points">Settlement amount is the amount received from client and relationship (loan) is terminated by client</p>
                        <p class="footer_points">Restructuring amounts come from Loan module and indicate the Loan amount that has been restructured</p>
                        <p class="footer_points">Report Source: Loan Module</p>
                    </div>
                </t>
            </t>
        </t>
    </template>


<odoo>
    <record id="report_loan_wizard_1" model="ir.ui.view">
        <field name="name">retail.report.one</field>
        <field name="model">retail.report.one</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Retail Report 1">
                <group>
                    <group>
                   <field name="date_from"/>
                   <field name="date_to"/>
                   <field name="partner_id"/>
                   </group>
                </group>
                <footer>
                    <button class="oe_highlight" name="get_report" string="Get Report" type="object"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <record id="retail_report_pdf_action_1" model="ir.actions.report">
            <field name="name">Retail Report 1 Action</field>
            <field name="report_type">qweb-pdf</field>
            <field name="model">retail.report.one</field>
            <field name="report_name">smart_loan_system.retail_report_template_1</field>
            <field name="report_file">smart_loan_system.retail_report_template_1</field>
     </record>

     <record id='retail_report_form_action_1' model='ir.actions.act_window'>
        <field name="name">Retail Report 1</field>
        <field name="res_model">retail.report.one</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'report_trigger':1}</field>
    </record>


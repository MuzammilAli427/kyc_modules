<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sb_approval_wizard_view_form" model="ir.ui.view">
            <field name="name">sb.approval.wizards.view.form</field>
            <field name="model">sb.approval.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="loan_id" invisible="1"/>
                            <field name="is_bod_approve" invisible="1"/>
                            <field name="action_require"  widget="radio" options="{'horizontal': true}"  attrs="{'invisible': [('is_bod_approve','=',False)]}"/>
                            <field name="first_action_require"  widget="radio" options="{'horizontal': true}" attrs="{'invisible': [('is_bod_approve','=',True)]}"/>
                        </group>
                    </sheet>

                    <footer>
                        <button name="confirm_first_action" type="object" class="btn btn-primary" string="Confirm"  attrs="{'invisible': [('is_bod_approve','=',True)]}"/>
                        <button name="confirm_action" type="object" class="btn btn-primary" string="Confirm" attrs="{'invisible': [('is_bod_approve','=',False)]}"/>
                        <button special="cancel" string="Cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="sb_approval_wizard_action" model="ir.actions.act_window">
            <field name="name">Send to SB?</field>
            <field name="res_model">sb.approval.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
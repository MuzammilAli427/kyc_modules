<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="loan_sequence_id" model="ir.sequence">
            <field name="name">My Sequence</field>
            <field name="code">my_sequence_code</field>
            <field name="prefix">LO/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="payment_installments_sequence_id" model="ir.sequence">
            <field name="name">Payment Installments Sequence</field>
            <field name="code">payment_ins_sequence_code</field>
            <field name="prefix">Sr NO/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
        </record>
    </data>
    <data>
        <record id="seq_account_loan" model="ir.sequence">
            <field name="name">Account loan sequence</field>
            <field name="code">account.loan</field>
            <field name="prefix">L/%(month)s%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>

     <data noupdate="0">
        <record id="seq_kyc_retail" model="ir.sequence">
            <field name="name">Kyc Retail sequence</field>
            <field name="code">kyc.retail</field>
<!--            <field name="prefix"></field>-->
            <field name="padding">5</field>
        </record>
    </data>

    <data noupdate="0">
        <record id="seq_kyc_corporate" model="ir.sequence">
            <field name="name">Kyc Corporate sequence</field>
            <field name="code">kyc.corporate</field>
<!--            <field name="prefix"></field>-->
            <field name="padding">5</field>
        </record>
    </data>

     <data noupdate="0">
        <record id="seq_kyc_group" model="ir.sequence">
            <field name="name">Kyc Group sequence</field>
            <field name="code">kyc.groups</field>
<!--            <field name="prefix"></field>-->
            <field name="padding">5</field>
        </record>
    </data>

    <data noupdate="0">
        <record id="cust_seq_kyc_group" model="ir.sequence">
            <field name="name">Kyc Group Customer Sequence</field>
            <field name="code">kyc.groups.cust</field>
            <!--            <field name="prefix"></field>-->
            <field name="padding">5</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="smart_loan_system.loan_accrual_form_view" model="ir.ui.view">
        <field name="name">smart_loan_system.loan_accrual_form_view</field>
        <field name="model">loan.accrual</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="rounding_button"
                            type="object" string="Round Values" class="oe_highlight" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <label for="loan_id"/>
                    <h1>
                        <field name="loan_id" required="1"/>
                    </h1>
                    <field name="currency_id"/>
                    <br/>
                    <group>
                        <group>
                            <field name="monthly_interest_accrue"/>
                            <field name="yearly_interest_accrue"/>
                            <field name="is_accrual_created"/>

                        </group>
                        <group>
                            <field name="daily_interest_accrue" string="Monthly Interest"/>
                            <field name="daily_penalty_accrue" string="Monthly Penalty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Interest Lines" id="interest_line_page">
                            <field name="loan_accrual_interest_ids">
                                <tree editable="bottom">
                                    <field name="loan_accrual_id" invisible="1"/>
                                    <field name="date" string="Date" required="1"/>
                                    <field name="next_installment_date" string="Next Installment Date"/>
                                    <field name="principal_amount" string="Principal Due"/>
                                    <field name="rate" string="Current Rate"/>
                                    <field name="interest_amount" string="Interest Amount" sum="Interest"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="loan_id" invisible="1"/>
                                    <field name="loan_line_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Penalty Lines" id="penalty_line_page">
                            <field name="loan_accrual_penalty_ids">
                                <tree editable="bottom">
                                    <field name="loan_accrual_id" invisible="1"/>
                                    <field name="date" string="Date" required="1"/>
                                    <field name="next_installment_date" string="Next Installment Date"/>
                                    <field name="amount_due" string="Amount Due"/>
                                    <field name="penalty_rate" string="Penalty Rate"/>
                                    <field name="penalty_amount" string="Penalty Amount" sum="Penalty"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="loan_id" invisible="1"/>
                                    <field name="loan_line_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="smart_loan_system.loan_accrual_tree_view" model="ir.ui.view">
        <field name="name">smart_loan_system.loan_accrual_tree_view</field>
        <field name="model">loan.accrual</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="loan_id"/>
                <field name="currency_id" invisible="1"/>
                <field name="daily_interest_accrue" string="Monthly Interest"/>
                <field name="daily_penalty_accrue" string="Monthly Penalty"/>
            </tree>
        </field>
    </record>

    <record id='smart_loan_system.loan_accrual_action' model='ir.actions.act_window'>
        <field name="name">Loan Accruals</field>
        <field name="res_model">loan.accrual</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Loan Accruals" id="smart_loan_system.menu_loan_accrual"
              parent="loan_management_menu" action="smart_loan_system.loan_accrual_action"
              sequence="4"/>
</odoo>
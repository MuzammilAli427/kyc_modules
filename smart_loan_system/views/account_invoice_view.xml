<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Invoice view to add fields and button -->
    <record id="customer_invoice_trust_form" model="ir.ui.view">
        <field name="name">account.customer.invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="loan_line_id" />
                <field name="emi" />
                <field name="is_down_payment" />
                <field name="is_restructuring_inv" attrs="{'invisible': [('move_type', '!=', 'entry')]}"/>
                <field name="is_automatic_entry" attrs="{'invisible': [('move_type', '!=', 'entry')]}"/>
                <field name="is_mistaken_reconcile" invisible="1"/>
            </field>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="context">{'from_validate':1}</attribute>
            </xpath>
        </field>
    </record>


</odoo>

<odoo>
    <record id="retail_form" model="ir.ui.view">
        <field name="name">Retail Form</field>
        <field name="model">kyc.retail</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="approve_retail" type="object"
                            string="Approve" groups="smart_loan_system.kyc_approver_group"
                            attrs="{'invisible': [('state', '!=', 'waiting_approval')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="attachment_tree_view"
                                type="object" icon="fa-files-o">
                            <field string="Documents" name="doc_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="open_corporate_record"
                                type="object" icon="fa-sitemap">
                            <field string="Corporate" name="doc_corp_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="open_groups_record"
                                type="object" icon="fa-sitemap">
                            <field string="Groups" name="kyc_groups_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="open_collateral_record"
                                type="object" icon="fa-sitemap">
                            <field string="Collaterals" name="loan_collateral_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="show_partner_loan"
                                type="object" icon="fa-money">
                            <field string="Loans" name="loan_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="show_partner_loan_payments"
                                type="object" icon="fa-comment">
                            <field string="Loan Payments" name="total_payment_amount" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="show_partner_invoices"
                                type="object" icon="fa-pencil-square-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_invoiced" widget='monetary'
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Invoiced</span>
                            </div>
                        </button>
                        <button type="object"
                                class="oe_stat_button"
                                id="retail_partner_ledger_button"
                                icon="fa-pencil-square-o"
                                name="open_partner_ledger"
                                string="Partner Ledger"
                                context="{'default_partner_id': 'partner_id'}">
                        </button>
                        <button class="oe_stat_button"
                                name="show_partner_due_invoices"
                                type="object" icon="fa-list">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_due" widget='monetary'
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Due</span>
                            </div>
                        </button>
                    </div>
                    <field name="is_approver" invisible="1"/>
                    <h1>
                        <field name="customer_name" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                    </h1>
                    <br/>
                    <notebook>
                        <page string="Customer Information">
                            <group>
                                <group string="PERSONAL INFORMATION">
                                    <field name="status" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="pep" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="customer_no" required="1" readonly="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="group_ids" options="{'no_create': True}" widget="many2many_tags" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="group_role_ids" options="{'no_create': True}" widget="many2many_tags" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="name" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="middle_name" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="last_name" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="gender" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="dob" widget="date" options="{'date_format': 'MMMM d, y'} "
                                           required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="is_require" invisible="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="birth_place" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="marital_status" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="id_no" attrs="{'required': [('is_require', '=', False)], 'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="id_expiration" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="driving_licence_no"
                                           attrs="{'required': [('is_require', '=', False)], 'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="driving_expiration" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="passport_no" attrs="{'required': [('is_require', '=', False)], 'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="issued_by" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="pass_expiration" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <label for="tel_home"/>
                                    <div>
                                        <field name="home_code" class="oe_inline" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                        <field name="tel_home" class="oe_inline" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    </div>
                                    <label for="tel_cellular" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <div>
                                        <field name="cellular_code" class="oe_inline" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                        <field name="tel_cellular" class="oe_inline" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    </div>
                                    <field name="mail" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                </group>
                                <group string="EMPLOYER INFO">
                                    <field name="employer" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="department" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="employer_address" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="employer_city" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <field name="employer_country_id" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <label for="tel_employer" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    <div>
                                        <field name="employer_code" class="oe_inline" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                        <field name="tel_employer" class="oe_inline" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                    </div>
                                </group>
                            </group>
                            <group string="HOME ADDRESS">
                                <field name="home_address" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                <field name="home_neighborhood" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                <field name="home_city" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                <field name="home_country_id" required="1" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                            </group>
                            <group string="MAILING ADDRESS">
                                <field name="mail_address" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                <field name="mail_neighborhood" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                <field name="mail_city" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                                <field name="mail_country_id" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="comment" attrs="{'readonly': [('is_approver', '=', True)]}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>


    <record id="retail_view_tree" model="ir.ui.view">
        <field name="name">Retail Tree</field>
        <field name="model">kyc.retail</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="mail"/>
                <field name="group_ids"/>
                <field name="customer_no"/>
            </tree>
        </field>
    </record>

    <record id="retail_view_kanban" model="ir.ui.view">
        <field name="name">Retail Kanban</field>
        <field name="model">kyc.retail</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="customer_name"/>
                <field name="employer"/>
                <field name="mail"/>
                <field name="home_city"/>
                <field name="home_country_id"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image:url('#{background_image}')">
                                <field name="image" widget="image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <h3>
                                        <field name="customer_name"/>
                                    </h3>
                                </strong>
                                <span>
                                    <field name="employer"/>
                                    <br/>
                                    <field name="home_city"/>,
                                    <field name="home_country_id"/>
                                    <br/>
                                    <field name="mail"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="view_kyc_retail_search">
        <field name="name">smart_loan_system.view_kyc_retail_search</field>
        <field name="model">kyc.retail</field>
        <field name="arch" type="xml">
            <search string="KYC Retail Search">
                <field name="customer_name"/>
                <field name="partner_id"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="pep"/>
                <field name="customer_no"/>
                <field name="group_ids"/>
                <field name="group_role_ids"/>
                <field name="dob"/>
                <field name="birth_place"/>
                <field name="name"/>
                <field name="middle_name"/>
                <field name="last_name"/>
                <field name="gender"/>
                <field name="marital_status"/>
                <field name="id_no"/>
                <field name="id_expiration"/>
                <field name="driving_licence_no"/>
                <field name="driving_expiration"/>
                <field name="passport_no"/>
                <field name="issued_by"/>
                <field name="pass_expiration"/>
                <field name="tel_home"/>
                <field name="home_code"/>
                <field name="cellular_code"/>
                <field name="tel_cellular"/>
                <field name="mail"/>
                <field name="home_address"/>
                <field name="home_neighborhood"/>
                <field name="home_city"/>
                <field name="home_country_id"/>
                <field name="mail_address"/>
                <field name="mail_neighborhood"/>
                <field name="mail_city"/>
                <field name="mail_country_id"/>
                <field name="employer"/>
                <field name="department"/>
                <field name="employer_address"/>
                <field name="employer_city"/>
                <field name="employer_country_id"/>
                <field name="tel_employer"/>
                <field name="employer_code"/>
                <field name="comment"/>
            </search>
        </field>
    </record>


    <record id='retail_action' model='ir.actions.act_window'>
        <field name="name">KYC Retail</field>
        <field name="res_model">kyc.retail</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('retail_view_kanban')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('retail_form')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('retail_view_tree')}),
                         ]"/>
    </record>

    <record id='kyc_action' model='ir.actions.act_window'>
        <field name="name">KYC Retail</field>
        <field name="res_model">kyc.retail</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('retail_view_kanban')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('retail_form')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('retail_view_tree')}),
                         ]"/>
    </record>

    <menuitem name="Smart Loan Management" id="loan_management_menu"
              web_icon="smart_loan_system,static/description/icon.png" groups="smart_loan_system.group_loan_user,smart_loan_system.group_loan_manager"/>
    <menuitem name="KYC" id="kyc_menu" parent="loan_management_menu" action="kyc_action" sequence="1"/>
    <menuitem name="Retail" id="retail_menu" parent="kyc_menu" action="retail_action"/>
</odoo>

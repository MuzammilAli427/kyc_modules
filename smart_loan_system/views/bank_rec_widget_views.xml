<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="view_bank_rec_widget_form_ext" model="ir.ui.view">
            <field name="name">bank.rec.widget.form.ext</field>
            <field name="model">bank.rec.widget</field>
            <field name="inherit_id" ref="account_accountant.view_bank_rec_widget_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_validate']" position="attributes">
                    <attribute name="groups">smart_loan_system.group_visible_bank_statement_button</attribute>
                </xpath>
                <xpath expr="//button[@name='button_reset']" position="attributes">
                    <attribute name="groups">smart_loan_system.group_visible_bank_statement_button</attribute>
                </xpath>

                <xpath expr="//button[@name='button_to_check']" position="attributes">
                    <attribute name="groups">smart_loan_system.group_visible_bank_statement_button</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>

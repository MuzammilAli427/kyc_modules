<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="write_off_move_form_view" model="ir.ui.view">
        <field name="name">Write Off Move Form View</field>
        <field name="model">write.off.move</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="submit_for_approval" type="object" class="btn btn-primary"
                            string="Submit For Approval" attrs="{'invisible': [('state', '!=', 'draft')]}" groups="smart_loan_system.group_loan_cao"/>
                    <button name="process_write_off_move" type="object" class="btn btn-primary" string="Process"
                            attrs="{'invisible': [('state', '!=', 'submit_approval')]}"
                            groups="smart_loan_system.group_loan_cam"/>
                     <button name="reject_write_off_move" type="object" class="btn btn-primary" string="Reject"
                            attrs="{'invisible': [('state', '!=', 'submit_approval')]}"
                            groups="smart_loan_system.group_loan_cam"/>
                    <!--                    <button name="cancel_write_off_move" string="Cancel" type="object"/>-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="edit_allow" invisible="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="loan_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="write_off_date" attrs="{'readonly':[('edit_allow', '=', False)]}"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="write_off_lines">
                            <field name="write_off_line_ids" attrs="{'readonly':[('edit_allow', '=', False)]}">
                                <tree editable="true">
                                    <field name="move_line_id" invisible="1"/>
                                    <field name="is_select"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="name" invisible="1"/>
                                    <field name="account_id" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="tax_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="currency_id" invisible="1" readonly="1"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="price_total" readonly="1"/>
                                    <field name="paid_amount" readonly="1"/>
                                    <field name="unpaid_amount" attrs="{'readonly':[('is_select','!=',True)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="write_off_move_action" model="ir.actions.act_window">
        <field name="name">Write-Off Move</field>
        <field name="res_model">write.off.move</field>
        <field name="view_mode">form</field>
    </record>

</odoo>

        <field name="name">account.account.ext.tree.view</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <field name="reconcile" position="after">
                <field name="transfer_type"  groups="base.group_no_one"/>
                <field name="transfer_account_id"  groups="base.group_no_one"/>
            </field>
        </field>
    </record>

</odoo>

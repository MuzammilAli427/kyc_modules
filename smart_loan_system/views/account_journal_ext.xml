<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_ext_form_view" model="ir.ui.view">
        <field name="name">account.journal.ext.form.view</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="search_allowed"/>
            </xpath>
        </field>
    </record>


    <record id="account_journal_ext_search_view" model="ir.ui.view">
        <field name="name">account.journal.ext.search.view</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='name']" position="after">
                <field name="search_allowed"/>
            </xpath>
<!--            <xpath expr="//search//field[@name='name']" position="attributes">-->
<!--                <attribute name="attrs">{'invisible': [('search_allowed', '!=', False)]}</attribute>-->
<!--            </xpath>-->
            <xpath expr="//search//filter[@name='dashboard']" position="attributes">
                <attribute name="attrs">{'invisible': [('search_allowed', '=', False)]}</attribute>
<!--                <attribute name="invisible">0</attribute>-->

            </xpath>
        </field>
    </record>

</odoo>

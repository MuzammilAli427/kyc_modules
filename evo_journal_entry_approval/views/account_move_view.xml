<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="evo_approval_view_move_form" model="ir.ui.view">
        <field name="name">evo.approval.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="approval_hide" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_submit_for_approval" string="Submit for Approval" class="oe_highlight"
                        type="object"
                        attrs="{'invisible': ['|', '|', '|', ('state', '!=', 'draft'), ('waiting_state', '!=', 'draft'), ('approval_hide','=',False), ('move_type', '!=','entry')]}"/>
                <button name="action_approvals" string="Approve" class="oe_highlight" type="object"
                        groups="evo_journal_entry_approval.group_evo_journal_approval"
                        attrs="{'invisible': ['|',('state', '!=', 'draft'),('waiting_state', '!=', 'waiting_for_approval')]}"/>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="attrs">{'invisible': ['|',('waiting_state','!=','waiting_for_approval'),('state', '=',
                    'cancel')]}
                </attribute>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', '|', ('state', '!=', 'draft'), ('auto_post', '=',
                    True), ('move_type', '!=', 'entry'), ('approval_hide','=',True)]}
                </attribute>
            </xpath>

            <xpath expr="//page[@id='other_tab_entry']/group/group/field[@name='company_id']" position="after">
                <field name="approved_by"/>
                <field name="approved_date"/>
            </xpath>

            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="waiting_state" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <style>
                    .bg-orange {
                    background: #F2A503 !important;
                    }
                </style>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <widget name="web_ribbon" bg_color="bg-orange" title="Waiting for Approval"
                        attrs="{'invisible': ['|', ('waiting_state', '!=', 'waiting_for_approval'),('move_type', '!=','entry')]}"/>
                <widget name="web_ribbon" bg_color="bg-success" title="Posted"
                        attrs="{'invisible': ['|', ('state', '!=', 'posted'),('move_type', '!=','entry')]}"/>
                <widget name="web_ribbon" bg_color="bg-danger"
                        title="Cancel"
                        attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
            </xpath>
        </field>
    </record>
</odoo>

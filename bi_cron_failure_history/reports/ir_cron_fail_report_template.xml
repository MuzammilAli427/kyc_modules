<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
		<template id="report_cron_failed_report">
			<t t-call="web.external_layout">
				<t t-set="doc" t-value="doc.with_context(lang=lang)"/>
				<div class="page">
					<div><br/><br/><br/><br/></div>
					<div class="oe_structure" />
						<h2 class="text-center">Schedule Failed Report</h2>
					<br/><br/>
					<h2></h2>
					
					<table width="100%" style="font-size:15px;font-family: 'Times New Roman', Times, serif;">
					
					<tr style="min-height:30px;line-height:20px;font-size:15px;font-family: 'Times New Roman', Times, serif;" width="100%" t-foreach="get_failed_cron_activities" t-as="record">
                         <t t-if="record">
                           <td style="font-family:verdana;background:#e6e6e6;color:#000000;padding-left:5px;padding-top:5px; padding-bottom:5px; border: 1px solid black;">
                               <center>
                                   <b>Cron job name: </b><span t-esc="record['Cron job name']"/> <br></br>
                                   <b>Date Time of Run : </b><span t-esc="record['Date Time of Run']"/> <br></br>
                                   <b>Details: </b> <span t-esc="record['Details']"/> <br></br>
                               </center>
                           </td>
                      	</t>
					</tr>
					</table>
				</div>
			</t>
		</template>

		<template id="cron_failed_report">
			<t t-call="web.html_container">
				<t t-foreach="docs" t-as="doc">
					<t t-call="bi_cron_failure_history.report_cron_failed_report" t-lang="lang" />
				</t>
			</t>
		</template>
</data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
    
        <data noupdate="1">
            <record id="cron_notify_msg_id" model="cron.notify">
                <field name="name">Cron Failure History</field>
            </record>
        </data>
        
        
    
		
		<record id="email_template_error_msg_cron" model="mail.template">
            <field name="name">Cron Failed Information</field>
            <field name="email_from">{{(user.email or '')}}</field>
            <field name="subject">{{user.company_id.name}} Scheduler Failed Information ({{object.name}})</field>
            <field name="email_to">${ object.email }</field>
            <field name="report_template" ref="bi_cron_failure_history.report_cron_failed_print"/>
            <field name="report_name">Schedule Failed Logs Report</field>
            <field name="model_id" ref="base.model_ir_cron"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html"><![CDATA[
<div style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif;
                                        font-size: 12px; color: rgb(34, 34, 34);
                                        background-color: rgb(255, 255, 255); ">
                <p>Dear Team,</p>
                <p>
                We have attached your Scheduler Failed Logs Report Please kindly check.
                If you have any query feel free to ask.
                </p>
                <br/>
                Best Regards,
                <br/>
                   <br/>
                <t t-out="user.name">

                <br/>
                <br/>
                <br/>

            </div>
            ]]>
            </field>
            <field name="lang">${object.lang}</field>
        </record>
		
		
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="warlock_financial_dashboard_financial_dashboard.wt_dashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-lg-7">
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">WT Dashboard</h1>
                                    <div>
                                        <select class="form-select" t-model="state.period" t-on-change="wtOnChangePeriod">
                                            <option value="0">Select Period</option>
                                            <option value="7">Last 7 Days</option>
                                            <option value="30">Last 30 Days</option>
                                            <option value="90">Last 90 Days</option>
                                            <option value="365">Last 365 Days</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <KpiCard onClick.bind="viewInvoice" name="'Invoices'" value="state.invoice.value" percentage="state.invoice.percentage" perName="'Since Last Period'"/>
                        <KpiCard onClick.bind="viewInvoice" name="'Payments'" value="state.paidInvoice.value" percentage="state.paidInvoice.percentage" perName="'Since Last Period'"/>
                        <KpiCard onClick.bind="viewInvoice" name="'Total Amount'" value="state.taxedAmount.totalAmount" percentage="12" perName="'Since Last Period'"/>
                        <KpiCard onClick.bind="viewInvoice" name="'Avg Amount Per Invoice'" value="state.taxedAmount.avgAmount" percentage="-12" perName="'Since Last Period'"/>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Monthly Invoice</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'doughnut'" title="'Monthly Invoice'"/>
                            </div> 
                        </div>
                        <div class="col-lg-6 m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Partner's Invoice</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'polarArea'" title="'Partner\'s Invoice'"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Monthly Invoice</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'line'" title="'Monthly Invoice'"/>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Partner's Invoice</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'bar'" title="'Partner\'s Invoice'"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
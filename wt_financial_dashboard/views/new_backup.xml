<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="warlock_financial_dashboard_financial_dashboard.wt_dashboard" owl="1">
        <div class="wt_dashboard_component overflow-auto vh-100">
            <div class="main-container d-flex bg-light">
                <div class="sidebar bg-white" id="wt_side_nav" t-att-class="{'active': state.toggleOpen}">
                  <div class="headar-box px-3 pt-3 pb-4 d-flex justify-content-between">
                    <h1 class="fs-4"><span class="text-primary rounded shadow border px-2 me-3" style="font-size: 36px;">Dashboard</span></h1>
                    <button class="btn d-block close-btn px-1 py-0 text-dark"  t-on-click="toggleSidebar"><i class="fas fa-stream"></i></button>
                    </div>
                    <ul class="list-unstyled px-2 py-4" t-att-class="{'wt_active': state.isSidebarActive}">
                        <li class="my-2" t-att-class="{'wt_active': state.activeItem === 'item1'}" t-on-click="() => setActiveItem('item1',state)"><a href="#" class="text-decoration-none my-4"><i class="fas fa-home mx-2 my-2"></i>Partner Ledger</a></li>
                        <li class="my-2" t-att-class="{'wt_active': state.activeItem === 'item2'}" t-on-click="() => setActiveItem('item2',state)"><a href="#" class="text-decoration-none my-2"><i class="fas fa-chart-line mx-2 my-2"></i>Profit And Loss</a></li>
                        <li class="my-2" t-att-class="{'wt_active': state.activeItem === 'item3'}" t-on-click="() => setActiveItem('item3',state)"><a href="#" class="text-decoration-none my-2"><i class="far fa-money-check mx-2 my-2"></i>Balance Sheet</a></li>
                        <li class="my-2" t-att-class="{'wt_active': state.activeItem === 'item4'}" t-on-click="() => setActiveItem('item4',state)"><a href="#" class="text-decoration-none my-3"><i class="far fa-file mx-2 my-2"></i>Executive Summary</a></li>
                        <li class="my-2" t-att-class="{'wt_active': state.activeItem === 'item5'}" t-on-click="() => setActiveItem('item5',state)"><a href="#" class="text-decoration-none my-2"><i class="fas fa-tachometer-alt mx-2 my-2"></i>Tax Report</a></li>
                        <li class="my-2" t-att-class="{'wt_active': state.activeItem === 'item6'}" t-on-click="() => setActiveItem('item6',state)"><a href="#" class="text-decoration-none my-2"><i class="fas fa-funnel-dollar mx-2 my-2"></i>Cash Flow</a></li>
                    </ul>
                </div>
                <div class="content wt_dashbord_block">
                    <nav class="navbar navbar-expand-lg bg-body-tertiary">
                        <div class="container-fluid">
                            <div class="d-flex justify-content-between d-block">
                              <button class="btn px-1 py-1 py-0 open-btn" t-on-click="toggleSidebar"><i class="fas fa-stream"></i></button>
                        </div>
                        </div>
                        <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                              <li class="nav-item text-nowrap">
                                <!-- <a class="nav-link active" aria-current="page" href="#"></a> -->
                              </li>
                            </ul>
                          </div>
                      </nav>
                      <div class="container">
                        <div class="row">
                          <div class="row">
                            <div class="col">
                                <div class="shadow-sm border m-2 p-4 bg-white">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h1 class="fw-bold" style="color:#4864b8;">Dashboard</h1>
                                        <div>
                                            <select class="form-select" t-model="state.period" t-on-change="wtOnChangePeriod">
                                                <option value="0">Select Period</option>
                                                <option value="7">Last 7 Days</option>
                                                <option value="30">Last 30 Days</option>
                                                <option value="90">Last 90 Days</option>
                                                <option value="365">Last 365 Days</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <Chartfiter dropdownLabel="state.wtDropdown.dropDownLabel" onClick.bind="getDropdown"/>
                        </div>
                        <div class="row">
                            <KpiCard onClick.bind="viewInvoice" name="'Invoices'" value="state.invoice.value" percentage="state.invoice.percentage" perName="'Since Last Period'"/>
                            <KpiCard onClick.bind="viewPayement" name="'Payments'" value="state.paidInvoice.value" percentage="state.paidInvoice.percentage" perName="'Since Last Period'"/>
                            <KpiCard onClick.bind="viewInvoice" name="'Total Amount'" value="state.taxedAmount.totalAmount" percentage="state.invoice.percentage" perName="'Since Last Period'"/>
                            <KpiCard onClick.bind="viewInvoice" name="'Avg Amount Per Invoice'" value="state.taxedAmount.avgAmount" percentage="state.invoice.percentage" perName="'Since Last Period'"/>
                        </div>
                        <div class="row">
                            <KpiCard onClick.bind="viewBills" name="'Bills'" value="state.wtbill.billCount" percentage="state.wtbill.BillPerCent" perName="'Since Last Period'"/>
                            <KpiCard onClick.bind="viewCreditNotes" name="'Credit Notes'" value="state.wtCredit.CreditCount" percentage="state.wtCredit.CreditPercent" perName="'Since Last Period'"/>
                            <KpiCard onClick.bind="viewDebitNotes" name="'Debit Notes'" value="state.wtDebit.DebitCount" percentage="state.wtDebit.DebitPercent" perName="'Since Last Period'"/>
                            <KpiCard onClick.bind="viewBills" name="'Avg Amount Per Bills'" value="state.wtbill.AvgBill" percentage="state.wtbill.BillPerCent" perName="'Since Last Period'"/>
                        </div>
                        </div>
                        <div class="row container">
                            <div class="col-md-8 col-sm-6 m-0 p-0">
                                <div class="shadow-sm border m-2 p-4 bg-white">
                                    <ChartRender type="'line'" title="'Monthly Invoice'" chartLabel="state.chartLabel" monthlyData="state.monthlyData" label="state.chartLabel" viewAction="state.reportAction" dSelect="state.dSelect" selectList="state.selectOption"/>
                                </div>
                                </div>
                                <div class="col-md-4 col-sm-6 m-0 p-0 pb-5 pb-md-0">
                                    <div class="shadow-sm border m-2 p-4 bg-white">
                                    <ChartRender type="'doughnut'" title="'Monthly Invoice'" chartLabel="state.chartLabel" monthlyData="state.monthlyData" label="state.chartLabel" viewAction="state.reportAction" dSelect="state.dSelect" selectList="state.selectOption"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>